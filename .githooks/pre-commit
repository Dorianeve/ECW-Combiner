#!/usr/bin/env bash
# Blocks commits that add likely-sensitive content. Enable with:
#   git config core.hooksPath .githooks
# Add organisation-specific strings (names, domains, internal URLs, one regex per line)
# to .sensitive-patterns -- that file is git-ignored on purpose, so the list itself never leaks.

added=$(git diff --cached --no-color -U0 --diff-filter=AM | grep -E '^\+[^+]' || true)
[ -z "$added" ] && exit 0

fail=0
check() { # $1 = description, $2 = regex
  # placeholder domains (example.org/.com/.net) are allowed
  hits=$(printf '%s\n' "$added" | grep -Ein -- "$2" | grep -Eiv '@example\.(org|com|net)' | head -5 || true)
  if [ -n "$hits" ]; then
    echo "Blocked: $1"; echo "$hits"; echo; fail=1
  fi
}

check "email address"            '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
check "personal/absolute Windows path" '[A-Za-z]:[\\/]+Users[\\/]+[^\\/ "]+'
check "possible credential"      '(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']+["'"'"']'

if [ -f .sensitive-patterns ]; then
  while IFS= read -r pat; do
    [ -z "$pat" ] && continue
    case "$pat" in \#*) continue;; esac
    check "matches local sensitive pattern" "$pat"
  done < .sensitive-patterns
fi

# Data files must never be staged
bad_files=$(git diff --cached --name-only --diff-filter=AM | grep -Ei '\.(xlsx|xls|rds|rdata)$|^(cache|output)/' | grep -v '^tests/testthat/fixtures/' || true)
if [ -n "$bad_files" ]; then echo "Blocked: data files staged:"; echo "$bad_files"; fail=1; fi

[ $fail -ne 0 ] && { echo "Commit aborted. Fix the above (or use --no-verify if you are certain)."; exit 1; }
exit 0
